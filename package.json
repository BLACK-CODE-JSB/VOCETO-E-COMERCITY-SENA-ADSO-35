{
  "name": "commercity",
  "version": "1.0.0",
  "description": "CommerCity - Marketplace Desktop App",
  "author": "JSB",

  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "build": {
    "appId": "com.commercity.app",
    "productName": "CommerCity",

    "directories": {
      "output": "dist"
    },

    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,

      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,

      "installerIcon": "assets/logo.ico",
      "uninstallerIcon": "assets/logo.ico",
      "installerHeaderIcon": "assets/logo.ico",

      "installerHeader": "assets/banner.bmp"
    }
  },

  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.3.0"
  }
}